pipeline {
    agent any

    stages {

        stage('Hello') {
            steps {
                echo 'Hello from Jenkins!'
            }
        }

        stage('Checkout') {
            steps {
                echo 'GitHub repository checked out successfully'
            }
        }

        stage('Build') {
            steps {
                echo 'Building CreditDebitNote application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }
    }
}